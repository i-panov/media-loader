# Server
SERVER_TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
API_PORT=8000

# Data directory on the host
HOST_DATA_DIR=./data

# Cache
CACHE_TTL=24h
CACHE_MAX_SIZE=5GB
CACHE_CLEANUP_INTERVAL=300
MIN_FREE_DISK=1GB

# Jobs
JOB_TTL=1h
JOB_TIMEOUT=12h
SOURCE_LOCK_TTL=120
QUEUED_REENQUEUE_SECONDS=10
MAX_CONCURRENT_JOBS=2
MAX_CONCURRENT_TRANSCODES=1
FAILED_RETRY_SECONDS=60
FAILED_RECORD_TTL=300
RETRY_AFTER_SECONDS=5

# Redis
REDIS_URL=redis://redis:6379/0

# byedpi
# Whitespace-separated arguments for ciadpi. Verify what works for your ISP.
BYEDPI_ARGS=--auto=torst --timeout 3 --tlsrec 3+s
PROXY_URL=socks5://byedpi:1080
PROXY_STATE_TTL=24h
DIRECT_SOCKET_TIMEOUT=15
DIRECT_PROBE_TIMEOUT=5

# Output preferences
DEFAULT_VIDEO_FORMAT=mp4
DEFAULT_AUDIO_FORMAT=mp3
QUALITY_LEVELS=240p,360p,480p,720p,1080p,1440p,2160p

# ffmpeg
VIDEO_CRF=18
VIDEO_PRESET=medium
AUDIO_AAC_BITRATE=256k
AUDIO_MP3_BITRATE=320k
AUDIO_OPUS_BITRATE=160k

# Optional cookies for yt-dlp
YTDLP_COOKIES_FILE=/config/cookies.txt

# Auth
AUTH_ENABLED=true
AUTH_TOKEN_PREFIX=mlk_
AUTH_LAST_USED_UPDATE_INTERVAL=60
DOCS_ENABLED=false
